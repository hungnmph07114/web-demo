# =========================================================================
# TechPulse Modular E-Commerce - Environment Configuration Template
# =========================================================================

# Cổng hoạt động của máy chủ (Mặc định: 3000)
PORT=3000

# Môi trường chạy ('development' hoặc 'production')
NODE_ENV=production

# Chuỗi kết nối cơ sở dữ liệu PostgreSQL (Supabase hoặc Postgres Server)
DATABASE_URL=postgresql://postgres.xxx:yyy@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Khóa bí mật ký mã hóa JWT Token phiên đăng nhập
JWT_SECRET=techpulse_super_secret_jwt_key_2026_production

# Cấu hình Webhook VietQR (Tùy chọn)
VIETQR_SECRET_TOKEN=techpulse_vietqr_webhook_secret_2026
